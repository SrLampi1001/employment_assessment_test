# Local dev defaults — copy to .env (gitignored) and adjust if needed.
# Both docker-compose.yml and frontend/vite.config.ts read from ./.
#
# See docs/DECISIONS.md "Phase 0 — No hardcoded ports" for the rationale.

# Host port that maps to the db container's internal 5432.
# Change if 5433 is also taken on this machine.
POSTGRES_PORT=5433

# Postgres credentials — dev placeholders only. Do not reuse these in any
# non-local environment. Production secrets are injected by the deploy
# platform; they never live in this file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=db_santiago_sanchez_nakamoto

# Vite dev server port. Change if 5173 is taken.
FRONTEND_PORT=5173

# ─── Phase 6: AI Copilot (RLS-gated RAG) ────────────────────────────────
# Mistral embeddings — get a key from https://console.mistral.ai/
# Free "Experiment" tier: 100 req/min, 1M tokens/month.
# The copilot embeds questions + message bodies via `mistral-embed` (1024 dims).
MISTRAL_API_KEY=

# NVIDIA NIM chat — get a key from https://build.nvidia.com/
# OpenAI-compatible endpoint at https://integrate.api.nvidia.com/v1
# Primary: mistralai/mistral-nemotron (Spanish-aware)
# Fallback: nvidia/nemotron-3.5-lightning-30b-a3b (faster, English)
NVIDIA_API_KEY=

# Optional: override model names (these are the defaults)
# MISTRAL_EMBED_MODEL=mistral-embed
# CHAT_MODEL_PRIMARY=mistralai/mistral-nemotron
# CHAT_MODEL_FALLBACK=nvidia/nemotron-3.5-lightning-30b-a3b
